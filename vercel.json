{
  "version": 2,
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{evyemeklerim.sqlite,public/**}"
    }
  },
  "headers": [
    {
      "source": "/uploads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/uploads/(.*)",
      "destination": "/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.mjs"
    }
  ]
}
