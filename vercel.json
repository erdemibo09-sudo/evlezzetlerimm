{
  "version": 2,
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{evyemeklerim.sqlite,public/**}"
    }
  },
  "rewrites": [
    {
      "source": "/uploads/(.*)",
      "destination": "/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.mjs"
    }
  ]
}
