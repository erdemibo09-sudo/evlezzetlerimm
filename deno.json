{
  "tasks": {
    "start": "deno run --no-npm --watch --allow-net --allow-read --allow-write --allow-env src/server.ts",
    "check": "deno check --no-npm src/server.ts tests/verification.test.ts",
    "test": "deno test --no-npm --allow-read --allow-write --allow-env tests/verification.test.ts",
    "build:vercel": "deno run --no-npm --allow-read --allow-write scripts/build-vercel.ts"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  }
}
